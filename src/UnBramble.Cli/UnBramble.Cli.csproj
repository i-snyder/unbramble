<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>unbramble</AssemblyName>
    <RootNamespace>UnBramble.Cli</RootNamespace>
    <Version>0.2.0</Version>
    <!-- Keep the CLI's version flag free of build metadata: without this, the SDK appends
         "+<git commit hash>" to AssemblyInformationalVersion inside a git repo. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Roslyn emits these dependency-level warnings under NativeAOT. The published-binary
         semantic-analysis smoke tests exercise the affected paths. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104;IL3000</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UnBramble.Core\UnBramble.Core.csproj" />
  </ItemGroup>

</Project>
